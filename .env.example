# Meshy API configuration — server only.
# Leave empty to keep the application in free local/demo mode.
# Never use NEXT_PUBLIC_ for this credential.
MESHY_API_KEY=

# Optional: official Meshy API base URL.
MESHY_API_BASE=https://api.meshy.ai

# Free local creation remains available without a Meshy API key.
# Real Meshy tasks are not wired in this branch yet.
